# Firebase web app config (Firebase Console → Project settings → Your apps → Web app).
# These are public identifiers, not secrets — but they ARE baked in at build time, so rebuild after changing them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair (public key)
VITE_FIREBASE_VAPID_KEY=
