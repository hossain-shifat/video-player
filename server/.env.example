# ─── Firebase Cloud Messaging (push delivery only) ────────────────────────────
# Use ONE of these. Never commit the real file/values.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=            # raw JSON, or base64 of it (handy for Docker/CasaOS env vars)

# ─── Notifications (all optional) ─────────────────────────────────────────────
# NOTIFICATION_RETENTION_DAYS=90            # read notifications older than this are pruned daily
# PUSH_STALE_DEVICE_DAYS=60                 # deactivated devices older than this are deleted
# STORAGE_CHECK_INTERVAL_MS=1800000         # 30 min
# STORAGE_ALERT_PERCENT=90                  # alert when a library disk is this % full…
# STORAGE_ALERT_MIN_FREE_GB=20              # …or has less than this much free (0 disables)
# STORAGE_ALERT_COOLDOWN_MS=86400000        # at most one alert per disk per day
