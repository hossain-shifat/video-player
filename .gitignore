# DOCKER / CASAOS / DEPLOYMENT RUNTIME
# ==========================================

docker-volumes/
**/docker-volumes/

casaos-data/
**/casaos-data/

# Runtime deployment data
/data/
**/data/


# ==========================================
# LOCAL DEVELOPMENT DATA
# ==========================================

runtime/
runtime-data/

**/runtime/
**/runtime-data/

server/runtime/
server/runtime-data/


# ==========================================
# LOCAL DATABASE / DEVELOPMENT DATABASES
# ==========================================

*.db
*.sqlite
*.sqlite3

# Keep Prisma migrations/schema trackable because
# they live under server/prisma/.


# ==========================================
# LARGE ARCHIVES / LOCAL BACKUPS
# ==========================================

*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z


# ==========================================
# DOCUMENTATION GENERATED LOCALLY
# ==========================================

docs/


# ==========================================
# MISCELLANEOUS GENERATED FILES
# ==========================================

*.cache
*.pid
*.seed
*.lock.tmp


# ==========================================
# LOCAL CERTIFICATES / KEYS
# ==========================================

*.pem
*.key
*.crt
*.cer

# Allow explicitly committed example certificates
!*.example.pem
!*.example.key
!*.example.crt


# ==========================================
# LOCAL AUTH / SESSION FILES
# ==========================================

.auth/
**/.auth/

sessions/
**/sessions/

cookies/
**/cookies/


# ==========================================
# LOCAL MACHINE / DEVELOPMENT CONFIG
# ==========================================

*.local.json
*.local.yaml
*.local.yml


# ==========================================
