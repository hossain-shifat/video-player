# ==========================================
# FLUX MEDIA SERVER - ROOT .GITIGNORE
# ==========================================


# ==========================================
# DEPENDENCIES
# ==========================================

node_modules/
**/node_modules/

.pnp
.pnp.js

.npm/
.yarn/
.pnpm-store/

# ==========================================
# BUILD OUTPUTS
# ==========================================

dist/
dist-ssr/
build/
out/

**/dist/
**/dist-ssr/
**/build/
**/out/

.vite/
**/.vite/

.cache/
**/.cache/

.turbo/
**/.turbo/

coverage/
**/coverage/


# ==========================================
# LOGS & DEBUGGING
# ==========================================

logs/
**/logs/

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

debug.log
error.log


# ==========================================
# ENVIRONMENT VARIABLES & SECRETS
# ==========================================

.env
.env.*
*.env
*.local

# Allow safe example environment files
!.env.example
!.env.sample
!.env.template


# ==========================================
# TEMPORARY FILES & BACKUPS
# ==========================================

*.tmp
*.temp
*.bak
*.old
*.backup
*.swp
*.swo
*.swn
*.orig
*.rej
*~

temp/
tmp/
**/temp/
**/tmp/

.local/
**/.local/


# ==========================================
# OPERATING SYSTEM FILES
# ==========================================

.DS_Store
**/.DS_Store

Thumbs.db
**/Thumbs.db

Thumbs.db:encryptable
Desktop.ini

ehthumbs.db
Icon?


# ==========================================
# IDE / EDITOR FILES
# ==========================================

.idea/
**/.idea/

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

*.suo
*.ntvs*
*.njsproj
*.sln

.history/
**/.history/


# ==========================================
# FLUX SERVER - RUNTIME DATA
# ==========================================

# Entire runtime data directory
/server/data/

# Runtime databases
server/data/*.db
server/data/*.sqlite
server/data/*.sqlite3

# Runtime JSON stores
server/data/history.json
server/data/userdata.json
server/data/folders.json
server/data/metadata.json
server/data/permissions.json
server/data/media.json

# Runtime metadata/cache
server/data/metadata/
server/data/cache/
server/data/posters/
server/data/thumbnails/
server/data/previews/

# Runtime subtitle data
server/data/subtitles/


# ==========================================
# FLUX SERVER - STREAMING DATA
# ==========================================

# Transcoding output
server/data/transcode/
server/data/transcodes/

# HLS output
server/data/hls/

# Streaming temporary files
server/data/stream/
server/data/streams/

# Generated HLS playlists
*.m3u8

# NOTE:
# Do NOT globally ignore *.ts.
# Do NOT globally ignore *.vtt.
#
# *.ts may be source code.
# *.vtt may be legitimate subtitle/test files.
#
# Runtime HLS/subtitle directories above are ignored instead.


# ==========================================
# FLUX SERVER - UPLOADS
# ==========================================

server/data/uploads/

uploads/
**/uploads/

upload-temp/
**/upload-temp/


# ==========================================
# GENERATED MEDIA / CACHE FILES
# ==========================================

*.part
*.partial

*.thumb
*.thumbnail

previews/
**/previews/

thumbnails/
**/thumbnails/


# ==========================================
# PLAYWRIGHT
# ==========================================

# Playwright HTML reports
**/playwright-report/
**/blob-report/

# Playwright test results
**/test-results/

# Playwright cache
**/playwright/.cache/

# Playwright authentication/session state
**/playwright/.auth/

# Playwright screenshots
**/playwright/screenshots/

# Playwright recorded videos
**/playwright/videos/

# Playwright traces
**/playwright/traces/

# Playwright browser binaries
**/ms-playwright/

# Playwright generated trace archives
**/*.trace.zip

# Playwright generated recordings
**/*.webm


# ==========================================
# TEST ARTIFACTS
# ==========================================

__snapshots__/
**/__snapshots__/

screenshots/
**/screenshots/

benchmarks/
**/benchmarks/

test-artifacts/
**/test-artifacts/

test-output/
**/test-output/

reports/
**/reports/

.nyc_output/
**/.nyc_output/


# ==========================================
# PRISMA
# ==========================================

# Prisma generated client/runtime artifacts
.prisma/
**/.prisma/

server/.prisma/

# IMPORTANT:
# Do NOT ignore:
# server/prisma/schema.prisma
# server/prisma/migrations/
#
# These should be committed to Git.


